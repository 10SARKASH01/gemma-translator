# Optional settings. Copy to speech.env before setup to persist them for
# setup.sh, start.sh, and the systemd service. Use absolute paths; systemd's
# EnvironmentFile does not expand shell variables or ~.
WHISPER_THREADS=4
SPEECH_TIMEOUT_SECONDS=300
PERSIAN_TTS_ENGINE=piper

# Defaults are models/offline-speech/ inside this checkout. Override to reuse
# an existing multilingual Whisper model/executable or Persian Piper voice.
# OFFLINE_SPEECH_DIR=/opt/gemma-translator/speech
# WHISPER_CPP_BINARY=/opt/whisper.cpp/build/bin/whisper-cli
# WHISPER_MODEL_PATH=/opt/models/ggml-small-q5_1.bin
# PIPER_FA_MODEL=/opt/voices/fa_IR-amir-medium.onnx
# PIPER_FA_CONFIG=/opt/voices/fa_IR-amir-medium.onnx.json
# ESPEAK_NG_BINARY=/usr/bin/espeak-ng

# Use PERSIAN_TTS_ENGINE=espeak-ng for a lighter, synthetic Persian voice.
